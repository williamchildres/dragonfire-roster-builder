{
  "name": "dragonfire-roster-builder",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:full-roster": "node scripts/audit-full-roster.mjs",
